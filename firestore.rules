rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'pvsuzokUtBPPEHCSJWLhNlEYMAH3';
    }

    match /siteContent/published {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/draft {
      allow read, write: if isAdmin();
    }

    match /siteVersions/{versionId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

